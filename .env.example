# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Khoá ký phiên đăng nhập - chuỗi ngẫu nhiên dài. Tạo bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Database app đang dùng. Để trống = SQLite trên máy (data/ftel.db).
# Trên Vercel: dán chuỗi "Transaction pooler" của Supabase (cổng 6543).
DATABASE_URL=

# Chỉ dùng khi chuyển dữ liệu từ máy lên Supabase (scripts/chuyen_len_supabase.py).
# Dùng chuỗi "Session pooler" (cổng 5432) - ổn định hơn cho việc chép dữ liệu lớn.
SUPABASE_DB_URL=

# Mặc định KHÔNG lưu tên khách hàng (báo cáo không dùng tới). Đặt true nếu thật sự cần.
LUU_TEN_KHACH_HANG=false

# AI (điền khi bật chatbot) - key chỉ nằm trên máy chủ
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_INSIGHT=
AI_ENABLED=false
